{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "env": {
    "NODE_OPTIONS": "--disable-warning=DEP0169"
  },
  "functions": {
    "api/**/*.js": {
      "maxDuration": 10
    }
  }
}
